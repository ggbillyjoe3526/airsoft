# Godot's cache and editor state (the .import and .uid files are committed)
.godot/
.import/
*.translation

# Builds and logs
build/
export/
dist/
*.log
pipeline/out/

# Local and OS files
*.local
.DS_Store
Thumbs.db
desktop.ini
.claude/launch.json

# Editor and tool leftovers (Blender's backups, merge and patch leftovers, swap files)
*.blend1
*.blend2
*.blend@
*.tmp
*.orig
*.rej
*.swp
*~

# Python tool caches
__pycache__/
