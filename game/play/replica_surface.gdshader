// A replica part in the hands and on the menus' pictures (MQ1, 2026-11-12): its paint on its surface (metal, polymer,
// wood), grained and, where its model carries a mask, lightly worn (RW1). See replica_surface.gdshaderinc.
shader_type spatial;
render_mode blend_mix, cull_back, diffuse_burley, specular_schlick_ggx;

#include "replica_surface.gdshaderinc"
